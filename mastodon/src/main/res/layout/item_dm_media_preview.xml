<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="72dp"
	android:layout_height="72dp"
	android:layout_marginEnd="8dp"
	android:layout_marginBottom="8dp">

	<ImageView
		android:id="@+id/dm_media_preview_image"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scaleType="centerCrop"
		android:background="@drawable/bg_compose_attachment"
		tools:src="#0f0"/>

	<ImageButton
		android:id="@+id/dm_media_preview_remove"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:layout_gravity="top|end"
		android:layout_margin="2dp"
		android:padding="4dp"
		android:background="@drawable/bg_dm_message_bubble"
		android:backgroundTint="#99000000"
		android:src="@drawable/ic_fluent_dismiss_24_filled"
		android:tint="#FFFFFF"
		android:contentDescription="@string/dm_remove_attachment"/>

	<ProgressBar
		android:id="@+id/dm_media_preview_progress"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:layout_gravity="center"
		android:visibility="gone"/>

</FrameLayout>
